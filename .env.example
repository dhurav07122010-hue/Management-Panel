# ============================================================
# MINECRAFT SERVER PANEL & PERSISTENT AGENT - ENVIRONMENT CONFIGURATION
# ============================================================

# Network & Cloud Control Backend Ports
PORT=3000
AGENT_PORT=3001
HOST=0.0.0.0

# Session & Security Secrets
SESSION_SECRET=change-this-to-a-very-secure-random-secret-at-least-32-chars
AGENT_AUTH_SECRET=change-this-to-a-secure-agent-auth-secret-key-32-chars

# Storage Paths
DATABASE_PATH=./data/panel.sqlite
SERVER_DIRECTORY=./data/minecraft-server
BACKUP_DIRECTORY=./backups

# Frontend API URL configuration (Optional for Vercel / Cloud deployments)
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com
# VITE_AGENT_URL=https://api.yourdomain.com

# Java & Minecraft Executables
JAVA_PATH=java
SERVER_JAR=fabric-server-launch.jar
MIN_RAM=2G
MAX_RAM=4G
JAVA_ARGS=-XX:+UseG1GC -XX:+ParallelRefProcEnabled -XX:MaxGCPauseMillis=200

# Mock Mode (Set to true to simulate Minecraft process without real Java server)
MOCK_MODE=false

# Automatic Backups (e.g. 0 */6 * * * for every 6 hours)
AUTO_BACKUP_ENABLED=true
AUTO_BACKUP_CRON=0 */6 * * *
BACKUP_RETENTION_COUNT=10

# Process Supervision & Crash Recovery
AUTO_RESTART_ON_CRASH=true
MAX_RESTART_ATTEMPTS=3
RESTART_DELAY_SECONDS=10
